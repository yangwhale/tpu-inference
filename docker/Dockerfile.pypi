# ==============================================================================
# Dockerfile.pypi Purpose:
# This Dockerfile is used for building and testing vLLM-TPU as a distributable 
# Python package. 
#
# Key differences from the standard Dockerfile:
# 1. It installs the 'vllm-tpu' package from a package index (PyPI).
# 2. It sets up the environment to run tests against the installed package.
# ==============================================================================

ARG BASE_IMAGE="python:3.12-slim-bookworm"
FROM $BASE_IMAGE

ARG IS_TEST="false"

# Update pip
RUN pip install --upgrade pip

# Install some basic utilities
RUN apt-get update && apt-get install -y \
    git \
    libopenmpi-dev \
    libomp-dev \
    procps \
    curl \
    rclone \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace/tpu_inference

# Install benchmarking requirements (not included in vllm-tpu package)
COPY requirements_benchmarking.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements_benchmarking.txt --retries 3

# Install test requirements (not included in vllm-tpu package)
COPY requirements_test.txt .
RUN --mount=type=cache,target=/root/.cache/pip if [ "$IS_TEST" = "true" ]; then \
        pip install -r requirements_test.txt --retries 3; \
    fi

# Copy the repository content (primarily for the tests/ directory)
COPY . .

# Clone vLLM repository purely to obtain its test scripts used by e2e/benchmarking
# WORKDIR /workspace
# ARG VLLM_COMMIT_HASH=""
# RUN git clone https://github.com/vllm-project/vllm.git && \
#     cd vllm && \
#     if [ -n "$VLLM_COMMIT_HASH" ]; then git checkout "$VLLM_COMMIT_HASH"; fi

# Install vLLM test dependencies required to run its test suite
# WORKDIR /workspace/vllm
# RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install -e tests/vllm_test_utils
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install \
    git+https://github.com/thuml/depyf.git \
    pytest-asyncio \
    "lm-eval[api]==0.4.9.2" \
    pytest-cov \
    tblib

# Install specific version of vllm-tpu from PyPI
RUN pip install --no-cache-dir vllm-tpu==0.18.0rc1

CMD ["/bin/bash"]
